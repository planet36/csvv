# Restore default SIGPIPE handling so broken pipes terminate silently, as in C.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

type Row = list[str]
type Rows = Iterator[Row]

# A 1-based position, or a slice of positions whose stop is inclusive.
type Choice = int | slice

type Number = int | float

# The csv module's default of 131072 characters rejects larger fields.
# sys.maxsize would overflow a C long on Windows.
FIELD_SIZE_LIMIT = 2**31 - 1

RAGGED_MODES = ('error', 'pad', 'truncate')

COMPARISONS: dict[str, Callable[[Any, Any], bool]] = {
    '==': operator.eq,
    '!=': operator.ne,
    '<': operator.lt,
    '<=': operator.le,
    '>': operator.gt,
    '>=': operator.ge,
}

REGEX_OPERATORS = ('~', '!~')

# Each negated operator and the operator it is the exact opposite of.
NEGATIONS = {'!=': '==', '!~': '~'}

# Only ASCII digits, as for numbers.  The group makes re.split() keep the runs.
DIGIT_RUN = re.compile('([0-9]+)')

# Two-character operators come first, so that the longest one wins where
# several start at the same place.
OPERATORS = sorted((*COMPARISONS, *REGEX_OPERATORS), key=len, reverse=True)


class DataError(Exception):
    '''A problem with the input data, as opposed to the command line.'''


@dataclasses.dataclass(frozen=True)
class Header:
    '''Column names from the first record.'''
    names: tuple[str, ...]

    def lookup(self, name: str) -> list[int]:
        '''Return the 0-based position of every column named name.'''
        return [i for i, n in enumerate(self.names) if n == name]

    def search(self, regex: re.Pattern[str]) -> list[int]:
        '''Return the 0-based position of every column whose name regex is found in.'''
        return [i for i, n in enumerate(self.names) if regex.search(n)]


@dataclasses.dataclass(frozen=True)
class Column:
    '''One column item, as the user wrote it.'''
    text: str

    @property
    def forced(self) -> bool:
        '''Whether a "#" prefix forces the item to be read as a position or a slice.'''
        return self.text.startswith('#')

    @property
    def choice_text(self) -> str:
        '''The text to read as a position or a slice.'''
        return self.text.removeprefix('#')


@dataclasses.dataclass(frozen=True)
class NamePattern:
    '''One --select-regex, which names every column whose name it is found in.'''
    text: str
    regex: re.Pattern[str]


# --select and --select-regex share one list, in the order they were given.
type SelectItem = Column | NamePattern


@dataclasses.dataclass(frozen=True)
class Resolved:
    '''The columns that one item names.'''
    column: Column
    positions: list[int]
    # Whether the item matched a column name, rather than being read as a
    # position or a slice.
    by_name: bool
    is_slice: bool


@dataclasses.dataclass(frozen=True)
class Condition:
    '''One -e test, COL OP VALUE.'''
    text: str
    column: Column
    op: str
    value: str
    # The value as a number, which makes a comparison numeric.
    number: Number | None
    regex: re.Pattern[str] | None

    @property
    def negated(self) -> bool:
        '''Whether the operator is != or !~.'''
        return self.op in NEGATIONS

    def holds(self, cell: str) -> bool:
        '''Whether cell passes the test, with == in place of != and ~ in place of !~.
In a numeric test, a cell that is not a number is never equal, less, or greater.'''

        if self.regex is not None:
            return self.regex.search(cell) is not None

        op = NEGATIONS.get(self.op, self.op)

        if self.number is not None:
            n = to_number(cell)
            return n is not None and COMPARISONS[op](n, self.number)

        return COMPARISONS[op](cell, self.value)

    def passes(self, cells: Iterable[str]) -> bool:
        '''Whether a row passes, given its cells in the columns that COL names.
A row passes when any of the cells holds.  A negated operator turns that
around, so != and !~ pass a row only when none of the cells has == or ~, and
stay the exact opposites of == and ~.'''
        return any(self.holds(cell) for cell in cells) != self.negated

    def matches(self, cell: str) -> bool:
        '''Whether one cell passes this test.  Only the tests call this.'''
        return self.passes((cell,))


@dataclasses.dataclass(frozen=True)
class SortKey:
    '''One --sort key, COL[:FLAGS].'''
    text: str
    column: Column
    numeric: bool
    natural: bool
    ignore_case: bool
    reverse: bool


@dataclasses.dataclass(frozen=True, slots=True)
class Descending:
    '''A sort key that sorts in reverse order.
sorted() needs only <.  The dataclass's == matters too: comparing key tuples
skips equal items with ==, so without it a tie here would end the comparison
before the next key.'''
    key: Any

    def __lt__(self, other: Self) -> bool:
        return bool(self.key > other.key)


@dataclasses.dataclass(frozen=True)
class Record:
    '''A row with its position in the input, for error messages.'''
    number: int
    line: int
    row: Row


@dataclasses.dataclass(frozen=True)
class Options:  # pylint: disable=too-many-instance-attributes
    '''The command line, with each option in its final form.'''
    file: str
    header: bool
    delimiter: str
    output_delimiter: str
    ragged: str
    filter: tuple[Condition, ...]
    sort: tuple[SortKey, ...]
    # The items of every --select and --select-regex, in order.
    select: tuple[SelectItem, ...]
    debug: bool


def separator(s: str) -> str:
    '''Convert s to a one-character field separator, where "\\t" means a tab.'''
    if s == r'\t':
        s = '\t'
    if len(s) != 1:
        raise argparse.ArgumentTypeError(r'must be one character, or \t for a tab')
    if s in '"\r\n':
        raise argparse.ArgumentTypeError('may not be a quote or a line break')
    return s


def to_number(s: str) -> Number | None:
    '''Convert s to a number, or return None if it is not one.
int() is tried first, so that long integers compare exactly, where float()
alone would make 9007199254740993 equal 9007199254740992.  NaN is not a number,
since it compares false with everything and would break a sort.

Only ASCII text can be a number.  int() and float() also read the digits of
other scripts, so without that check a cell holding 12 in Arabic-Indic digits
would equal 12.

An integer longer than 4300 digits, Python's default limit for int(), falls
through to float() and becomes infinite, so two such integers compare equal.
Lifting the limit would let one huge field take quadratic time to parse.'''

    if not s.isascii():
        return None

    try:
        return int(s)
    except ValueError:
        pass

    try:
        n = float(s)
    except ValueError:
        return None

    return None if math.isnan(n) else n


def parse_choice(s: str) -> Choice | None:
    '''Convert s to a 1-based position, or to a slice whose stop is inclusive.
Return None if s is not written as either.  Raise ValueError for a 0, which is
never a valid position, endpoint, or step.'''

    parts = s.split(':')

    if len(parts) > 3:
        return None

    try:
        numbers = [None if not p else int(p) for p in parts]
    except ValueError:
        return None

    if len(numbers) == 1:
        position = numbers[0]
        if position is None:
            return None
        if position == 0:
            raise ValueError('columns are numbered from 1, so 0 is not a position')
        return position

    if 0 in numbers[:2]:
        raise ValueError('columns are numbered from 1, so a slice may not use 0')

    if len(numbers) == 3 and numbers[2] == 0:
        raise ValueError('a slice may not have a step of 0')

    return slice(*numbers)


def pick(choice: Choice, width: int) -> list[int]:
    '''Return the 0-based positions that choice picks from width columns.
A position out of range picks nothing, and a slice is clamped to the columns
that exist, as in Python.'''

    def index(n: int) -> int:
        return n - 1 if n > 0 else width + n

    if isinstance(choice, int):
        i = index(choice)
        return [i] if 0 <= i < width else []

    step = 1 if choice.step is None else choice.step
    first = None if choice.start is None else index(choice.start)
    last = None if choice.stop is None else index(choice.stop)

    if step > 0:
        low = 0 if first is None else max(first, 0)
        high = width - 1 if last is None else min(last, width - 1)
        return list(range(low, high + 1, step))

    high = width - 1 if first is None else min(first, width - 1)
    low = 0 if last is None else max(last, 0)
    return list(range(high, low - 1, step))


def resolve_column(column: Column, header: Header | None, width: int) -> Resolved:
    '''Work out which columns one item names.
With a header, an item that exactly matches a column name refers to that column,
even when it could also be read as a position.  A name that occurs more than
once is an error, and a "#" item is never looked up as a name.'''

    if header is not None and not column.forced:
        matches = header.lookup(column.text)
        if len(matches) > 1:
            numbers = join_and([str(i + 1) for i in matches])
            raise DataError(f'column name {column.text!r} is ambiguous, since columns '
                            f'{numbers} {"both" if len(matches) == 2 else "all"} have it')
        if matches:
            return Resolved(column, matches, by_name=True, is_slice=False)

    try:
        choice = parse_choice(column.choice_text)
    except ValueError as e:
        raise DataError(f'{column.text!r}: {e}') from e

    if choice is None:
        raise DataError(f'no column named {column.text!r}')

    return Resolved(column, pick(choice, width), by_name=False,
                    is_slice=isinstance(choice, slice))


def resolve(columns: Iterable[Column], header: Header | None, width: int) -> list[int]:
    '''Return the 0-based positions that columns name, in order.  Only the tests call this.'''
    return [i for c in columns for i in resolve_column(c, header, width).positions]


def resolve_some(column: Column, header: Header | None, width: int) -> Resolved:
    '''Work out which columns one item names, where naming none is an error.'''

    resolved = resolve_column(column, header, width)

    if not resolved.positions:
        raise out_of_range(column, width)

    return resolved


def count(n: int, noun: str) -> str:
    '''Return n with noun, made plural unless n is 1.'''
    return f'{n} {noun}' if n == 1 else f'{n} {noun}s'


def join_and(words: list[str]) -> str:
    '''Join words as "a", "a and b", or "a, b, and c".'''
    if len(words) <= 2:
        return ' and '.join(words)
    return f'{", ".join(words[:-1])}, and {words[-1]}'


def out_of_range(column: Column, width: int) -> DataError:
    '''Return the error for a column that names no column of the input.'''
    return DataError(f'column {column.text!r} is out of range, '
                     f'since the input has {count(width, "column")}')


def check_forced(column: Column) -> None:
    '''Raise ArgumentTypeError for a "#" item that is not a valid position or slice.
Such an item needs no header, so it can be checked while parsing.'''

    if not column.forced:
        return

    try:
        choice = parse_choice(column.choice_text)
    except ValueError as e:
        raise argparse.ArgumentTypeError(f'{column.text!r}: {e}') from e

    if choice is None:
        raise argparse.ArgumentTypeError(
                f'{column.text!r}: "#" must be followed by a position or a slice')


def column_list(s: str) -> list[Column]:
    '''Split s at each comma into column items, checking what does not depend on a header.'''

    columns = [Column(item) for item in s.split(',')]

    for column in columns:
        if not column.text:
            raise argparse.ArgumentTypeError(f'{s!r} has an empty item')
        check_forced(column)

    return columns


def name_pattern(s: str) -> list[NamePattern]:
    '''Compile s as a --select-regex.
Return a list of one item, as column_list() does, since both options append to
one list.'''

    try:
        regex = re.compile(s)
    except re.error as e:
        raise argparse.ArgumentTypeError(f'{s!r}: invalid regex: {e}') from e

    return [NamePattern(s, regex)]


def condition(s: str) -> Condition:
    '''Parse s as COL OP VALUE, splitting it at the first operator from the left.'''

    for i in range(len(s)):
        op = next((op for op in OPERATORS if s.startswith(op, i)), None)
        if op is not None:
            break
    else:
        raise argparse.ArgumentTypeError(
                f'{s!r} has no operator, which is one of '
                f'{", ".join((*COMPARISONS, *REGEX_OPERATORS))}')

    column = Column(s[:i].strip())
    value = s[i + len(op):].strip()

    if not column.text:
        raise argparse.ArgumentTypeError(f'{s!r} has no column before {op!r}')

    check_forced(column)

    if op in REGEX_OPERATORS:
        try:
            regex = re.compile(value)
        except re.error as e:
            raise argparse.ArgumentTypeError(f'{s!r}: invalid regex: {e}') from e
        return Condition(s, column, op, value, None, regex)

    return Condition(s, column, op, value, to_number(value), None)


def sort_key(s: str) -> SortKey:
    '''Parse s as COL[:FLAGS].
FLAGS is the text after the last ":", when that text is made only of the
letters i, n, r, and v.  Otherwise the whole of s is the column, so "2:" is the
slice from column 2 onward, as in --select.  A column whose name ends in such
letters, such as "a:n", is therefore named by position.'''

    head, colon, flags = s.rpartition(':')

    if colon and flags and set(flags) <= set('inrv'):
        column = Column(head)
    else:
        column, flags = Column(s), ''

    if not column.text:
        raise argparse.ArgumentTypeError(f'{s!r} has no column')

    if 'n' in flags and 'v' in flags:
        raise argparse.ArgumentTypeError(f'{s!r} has both n and v, which exclude each other')

    check_forced(column)

    return SortKey(s, column, 'n' in flags, 'v' in flags, 'i' in flags, 'r' in flags)


def check_without_header(columns: Iterable[Column]) -> str | None:
    '''Return a problem with columns when there is no header to find names in.'''

    for column in columns:
        try:
            choice = parse_choice(column.choice_text)
        except ValueError as e:
            return f'{column.text!r}: {e}'
        if choice is None:
            return f'{column.text!r} is a column name, which needs -H'

    return None


def read_records(stream: TextIO, delimiter: str, source: str) -> Iterator[Record]:
    '''Yield each record of stream, numbered from 1, with the line it starts on.
Blank lines are skipped and not counted, since the csv writer never produces
one for a record that holds a value.'''

    # strict=True turns a stray quote into an error.  Without it, '"a" b' would
    # silently read as 'a b', and an unclosed quote would swallow the rest of
    # the input into one field.
    reader = csv.reader(stream, delimiter=delimiter, strict=True)
    number = 0
    start = 1

    while True:
        try:
            row = next(reader)
        except StopIteration:
            return
        except csv.Error as e:
            raise DataError(f'{source}: record {number + 1}, line {start}: {e}') from e
        except OSError as e:
            # A failed read has no file name, and main() takes an OSError
            # without one to be a failed write to stdout.
            raise DataError(f'{source}: record {number + 1}, line {start}: '
                            f'{e.strerror or e}') from e

        if row:
            number += 1
            yield Record(number, start, row)

        # line_num counts physical lines, so a record holding a quoted line
        # break moves it on by more than one.
        start = reader.line_num + 1


def fit_rows(records: Iterable[Record], width: int, ragged: str, source: str) -> Rows:
    '''Yield each row, after making it width fields long as ragged allows, and
raise DataError for a row that ragged does not fix.'''

    for record in records:
        row = record.row
        if len(row) == width:
            yield row
        elif len(row) < width and ragged == 'pad':
            yield row + [''] * (width - len(row))
        elif len(row) > width and ragged == 'truncate':
            yield row[:width]
        else:
            raise DataError(f'{source}: record {record.number}, line {record.line}: '
                            f'expected {count(width, "field")}, found {len(row)}')


def read(stream: TextIO, delimiter: str, has_header: bool, ragged: str,
         source: str) -> tuple[Header | None, int | None, Rows]:
    '''Read the header, if has_header, and the rows from stream.
The first record sets the width that every other row is made to match, so the
stages work out column positions once from the width and use them for every
row.  The width is None when the input is empty.'''

    records = read_records(stream, delimiter, source)
    first = next(records, None)

    if first is None:
        return None, None, iter(())

    width = len(first.row)

    if has_header:
        return Header(tuple(first.row)), width, fit_rows(records, width, ragged, source)

    rows = fit_rows(itertools.chain((first,), records), width, ragged, source)
    return None, width, rows


def describe(positions: Iterable[int], header: Header | None) -> str:
    '''Describe 0-based positions as 1-based columns, with their names if known.'''

    parts = [str(i + 1) if header is None else f'{i + 1} ({header.names[i]!r})'
             for i in positions]

    if not parts:
        return 'no columns'

    return ('column ' if len(parts) == 1 else 'columns ') + ', '.join(parts)


class Debug:
    '''The diagnostics and warnings of --debug.
Everything goes to stderr, so stdout stays valid CSV.  When debugging is off,
every method does nothing, and rows pass through untouched.'''

    def __init__(self, enabled: bool, prog: str) -> None:
        self.enabled = enabled
        self.prog = prog
        self.counts: dict[str, int] = {}

    def note(self, message: str) -> None:
        '''Report what csvv made of an option.'''
        if self.enabled:
            print(f'{self.prog}: {message}', file=sys.stderr)

    def warn(self, message: str) -> None:
        '''Report questionable usage.'''
        if self.enabled:
            print(f'{self.prog}: warning: {message}', file=sys.stderr)

    def check_name(self, label: str, resolved: Resolved) -> None:
        '''Warn when a column name matched an item that could be a position or a slice.'''

        if not self.enabled or not resolved.by_name:
            return

        try:
            choice = parse_choice(resolved.column.text)
        except ValueError:
            return

        if choice is not None:
            self.warn(f'{label} matched the column named {resolved.column.text!r}, '
                      f'so write "#{resolved.column.text}" to mean the position')

    def counting(self, rows: Rows, name: str) -> Rows:
        '''Count the rows as they pass, under name.'''

        if not self.enabled:
            return rows

        self.counts[name] = 0

        def generate() -> Rows:
            for row in rows:
                self.counts[name] += 1
                yield row

        return generate()

    def non_numbers(self, rows: Rows, checks: list[tuple[str, int]],
                    consequence: str) -> Rows:
        '''Count the cells that are not numbers, at each position that checks
names, and warn about them once every row has passed.'''

        if not self.enabled or not checks:
            return rows

        def generate() -> Rows:
            tally = [0] * len(checks)
            for row in rows:
                for k, (_, i) in enumerate(checks):
                    if to_number(row[i]) is None:
                        tally[k] += 1
                yield row
            for (label, _), n in zip(checks, tally):
                if n:
                    self.warn(f'{label} met {count(n, "cell")} that '
                              f'{"is not a number" if n == 1 else "are not numbers"}, '
                              f'which {consequence}')

        return generate()


def keep_matching(header: Header | None, width: int, rows: Rows,
                  conditions: Iterable[Condition], debug: Debug) -> tuple[Header | None, Rows]:
    '''Keep only the rows that pass every condition.
How a slice passes a row is in Condition.passes.'''

    tests: list[tuple[Condition, list[int]]] = []

    for c in conditions:
        label = f'-e {c.text!r}'
        resolved = resolve_some(c.column, header, width)
        debug.check_name(label, resolved)
        mode = ('a regex search' if c.regex is not None else
                'comparing numbers' if c.number is not None else 'comparing text')
        value = c.value if c.number is not None else repr(c.value)
        where = describe(resolved.positions, header)
        op = c.op
        if resolved.is_slice:
            # "none of columns 2, 3 == 0" reads more plainly than "!=" would.
            where = f'{"none" if c.negated else "any"} of {where}'
            op = NEGATIONS.get(op, op)
        debug.note(f'{label}: {where} {op} {value}, {mode}')
        tests.append((c, resolved.positions))

    # A cell that is not a number is never equal to VALUE, so != passes it.
    numeric = [(f'-e {c.text!r}', i, c.op == '!=')
               for c, positions in tests if c.number is not None for i in positions]
    rows = debug.non_numbers(rows, [(label, i) for label, i, unequal in numeric if unequal],
                             'counted as unequal')
    rows = debug.non_numbers(rows, [(label, i) for label, i, unequal in numeric if not unequal],
                             'failed the comparison')

    return header, (row for row in rows
                    if all(c.passes(row[i] for i in positions) for c, positions in tests))


def natural_key(cell: str) -> tuple[str | tuple[int, str, str], ...]:
    '''Return what to sort cell by in natural order, where file2 comes before file10.
re.split() puts text at the even indexes and runs of digits at the odd ones,
so two keys never compare text with a run.  A run compares by its length
without leading zeros, and then as text, which gives numeric order without
int() and its limit on length.  Runs of equal value then compare as written,
so file02 sorts before file2 rather than tying with it, as in sort -V.'''

    return tuple(part if i % 2 == 0 else (len(digits := part.lstrip('0')), digits, part)
                 for i, part in enumerate(DIGIT_RUN.split(cell)))


def text_key(cell: str, natural: bool, ignore_case: bool) -> Any:
    '''Return what to sort cell by as text.
With ignore_case, text compares after str.casefold(), and text that folds the
same then compares as written, so A sorts just before a rather than tying.'''

    folded = cell.casefold() if ignore_case else cell
    key = natural_key(folded) if natural else folded
    return (key, cell) if ignore_case else key


def cell_key(cell: str, key: SortKey) -> Any:
    '''Return what to sort cell by.
In a numeric key, a cell that is not a number sorts after the numbers in both
directions, and among the others as text.  The tags 0 and 1 keep a number from
ever being compared with text.'''

    if key.numeric and (n := to_number(cell)) is not None:
        return (0, -n if key.reverse else n)

    text = text_key(cell, key.natural, key.ignore_case)
    if key.reverse:
        text = Descending(text)
    return (1, text) if key.numeric else text


def sort_rows(header: Header | None, width: int, rows: Rows, keys: Iterable[SortKey],
              debug: Debug) -> tuple[Header | None, Rows]:
    '''Sort the rows by the keys, the first key taking priority.
A slice stands for one key per column, all with the same flags.  The sort is
stable, and it holds every row in memory.'''

    parts: list[tuple[int, SortKey]] = []
    numeric_checks: list[tuple[str, int]] = []

    for key in keys:
        label = f'--sort {key.text!r}'
        resolved = resolve_some(key.column, header, width)
        debug.check_name(label, resolved)
        order = ('as numbers' if key.numeric else
                 'as text in natural order' if key.natural else 'as text')
        debug.note(f'{label}: {describe(resolved.positions, header)}, {order}'
                   f'{", ignoring case" if key.ignore_case else ""}'
                   f'{", reversed" if key.reverse else ""}')
        parts.extend((i, key) for i in resolved.positions)
        if key.numeric:
            numeric_checks.extend((label, i) for i in resolved.positions)

    debug.note('sorting holds every row in memory')

    rows = debug.non_numbers(rows, numeric_checks, 'sorted after the numbers')

    def row_key(row: Row) -> tuple[Any, ...]:
        return tuple(cell_key(row[i], key) for i, key in parts)

    return header, iter(sorted(rows, key=row_key))


def select(header: Header | None, width: int, rows: Rows, items: Iterable[SelectItem],
           debug: Debug) -> tuple[Header | None, Rows]:
    '''Keep only the named columns, in the order named.
A NamePattern names every column whose name it is found in, in header order,
and naming none is an error, as an unknown name is.  A position out of range is
ignored, but ignoring every item is an error, since a row of no fields can only
be written as a blank line.'''

    positions: list[int] = []
    ignored: list[str] = []

    for column in items:
        if isinstance(column, NamePattern):
            found = [] if header is None else header.search(column.regex)
            if not found:
                raise DataError(f'no column name matches the regex {column.text!r}')
            debug.note(f'--select-regex {column.text!r}: {describe(found, header)}')
            positions.extend(found)
            continue

        label = f'--select {column.text!r}'
        resolved = resolve_column(column, header, width)
        debug.check_name(label, resolved)
        if resolved.positions:
            debug.note(f'{label}: {describe(resolved.positions, header)}')
        else:
            debug.warn(f'{label} was ignored, since the input has '
                       f'{count(width, "column")}')
            ignored.append(repr(column.text))
        positions.extend(resolved.positions)

    if not positions:
        raise DataError(f'--select chose no columns, since {join_and(ignored)} '
                        f'{"is" if len(ignored) == 1 else "are"} out of range '
                        f'and the input has {count(width, "column")}')

    if header is not None:
        header = Header(tuple(header.names[i] for i in positions))

    return header, ([row[i] for i in positions] for row in rows)


def write(stream: TextIO, delimiter: str, header: Header | None, rows: Rows) -> None:
    '''Write the header, if any, and the rows to stream as CSV.'''

    # The default line terminator is '\r\n', which upsets diff and wc -l.
    writer = csv.writer(stream, delimiter=delimiter, lineterminator='\n')

    if header is not None:
        writer.writerow(header.names)

    writer.writerows(rows)


def configure_stdio() -> None:
    '''Set up stdin and stdout the way the csv module needs them.'''

    # newline='' keeps a quoted line break intact and stops '\r\n' from
    # doubling on Windows.  utf-8-sig drops a byte-order mark, which would
    # otherwise join the first column name.  surrogateescape passes invalid
    # UTF-8 through unchanged.  A stream is None when its descriptor was
    # closed at startup, as in "csvv in.csv <&-", and has no reconfigure().
    if isinstance(sys.stdin, io.TextIOWrapper):
        sys.stdin.reconfigure(encoding='utf-8-sig', errors='surrogateescape', newline='')
    if isinstance(sys.stdout, io.TextIOWrapper):
        sys.stdout.reconfigure(encoding='utf-8', errors='surrogateescape', newline='')


def make_parser() -> argparse.ArgumentParser:
