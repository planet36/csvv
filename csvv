'''
Filter, sort, and select the columns of a CSV file.
'''

__author__ = 'Steven Ward'
__license__ = 'MPL-2.0'
__version__ = '2026-10-16'

import argparse
import contextlib
import csv
import dataclasses
import io
import itertools
import math
import operator
import re
import signal
import sys
from collections.abc import Callable, Iterable, Iterator
from typing import Any, Self, TextIO

# Restore default SIGPIPE handling so broken pipes terminate silently, as in C.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

type Row = list[str]
type Rows = Iterator[Row]

# A 1-based position, or a slice of positions whose stop is inclusive.
type Choice = int | slice

type Number = int | float

# The csv module's default of 131072 bytes rejects larger fields.
# sys.maxsize would overflow a C long on Windows.
FIELD_SIZE_LIMIT = 2**31 - 1

RAGGED_MODES = ('error', 'pad', 'truncate')

COMPARISONS: dict[str, Callable[[Any, Any], bool]] = {
    '==': operator.eq,
    '!=': operator.ne,
    '<': operator.lt,
    '<=': operator.le,
    '>': operator.gt,
    '>=': operator.ge,
}

REGEX_OPERATORS = ('~', '!~')

# Two-character operators come first, so that the longest one wins where
# several start at the same place.
OPERATORS = sorted((*COMPARISONS, *REGEX_OPERATORS), key=len, reverse=True)


class DataError(Exception):
    '''A problem with the input data, as opposed to the command line.'''


@dataclasses.dataclass(frozen=True)
class Header:
    '''Column names from the first record.'''
    names: tuple[str, ...]

    def lookup(self, name: str) -> list[int]:
        '''Return the 0-based position of every column named name.'''
        return [i for i, n in enumerate(self.names) if n == name]


@dataclasses.dataclass(frozen=True)
class Column:
    '''One column item, as the user wrote it.'''
    text: str

    @property
    def forced(self) -> bool:
        '''Whether a "#" prefix forces the item to be read as a position or a slice.'''
        return self.text.startswith('#')

    @property
    def choice_text(self) -> str:
        '''The text to read as a position or a slice.'''
        return self.text.removeprefix('#')


@dataclasses.dataclass(frozen=True)
class Resolved:
    '''The columns that one item names.'''
    column: Column
    positions: list[int]
    # Whether the item matched a column name, rather than being read as a
    # position or a slice.
    by_name: bool
    is_slice: bool


@dataclasses.dataclass(frozen=True)
class Condition:
    '''One -e test, COL OP VALUE.'''
    text: str
    column: Column
    op: str
    value: str
    # The value as a number, which makes a comparison numeric.
    number: Number | None
    regex: re.Pattern[str] | None

    def matches(self, cell: str) -> bool:
        '''Whether cell passes this test.'''

        if self.regex is not None:
            return (self.regex.search(cell) is None) == (self.op == '!~')

        if self.number is not None:
            n = to_number(cell)
            if n is None:
                return self.op == '!='
            return COMPARISONS[self.op](n, self.number)

        return COMPARISONS[self.op](cell, self.value)


@dataclasses.dataclass(frozen=True)
class SortKey:
    '''One --sort key, COL[:FLAGS].'''
    text: str
    column: Column
    numeric: bool
    reverse: bool


@dataclasses.dataclass(frozen=True, slots=True)
class Descending:
    '''Text that sorts in reverse order.'''
    text: str

    def __lt__(self, other: Self) -> bool:
        return self.text > other.text


@dataclasses.dataclass(frozen=True)
class Record:
    '''A row with its position in the input, for error messages.'''
    number: int
    line: int
    row: Row


def separator(s: str) -> str:
    '''Convert s to a one-character field separator, where "\\t" means a tab.'''
    if s == r'\t':
        s = '\t'
    if len(s) != 1:
        raise argparse.ArgumentTypeError(r'must be one character, or \t for a tab')
    if s in '"\r\n':
        raise argparse.ArgumentTypeError('may not be a quote or a line break')
    return s


def to_number(s: str) -> Number | None:
    '''Convert s to a number, or return None if it is not one.
int() is tried first, so that long integers compare exactly, where float()
alone would make 9007199254740993 equal 9007199254740992.  NaN is not a number,
since it compares false with everything and would break a sort.'''

    try:
        return int(s)
    except ValueError:
        pass

    try:
        n = float(s)
    except ValueError:
        return None

    return None if math.isnan(n) else n


def parse_choice(s: str) -> Choice | None:
    '''Convert s to a 1-based position, or to a slice whose stop is inclusive.
Return None if s is not written as either.  Raise ValueError for a 0, which is
never a valid position, endpoint, or step.'''

    parts = s.split(':')

    if len(parts) > 3:
        return None

    try:
        numbers = [None if not p else int(p) for p in parts]
    except ValueError:
        return None

    if len(numbers) == 1:
        position = numbers[0]
        if position is None:
            return None
        if position == 0:
            raise ValueError('columns are numbered from 1, so 0 is not a position')
        return position

    if 0 in numbers:
        raise ValueError('columns are numbered from 1, so a slice may not use 0')

    return slice(*numbers)


def pick(choice: Choice, width: int) -> list[int]:
    '''Return the 0-based positions that choice picks from width columns.
A position out of range picks nothing, and a slice is clamped to the columns
that exist, as in Python.'''

    def index(n: int) -> int:
        return n - 1 if n > 0 else width + n

    if isinstance(choice, int):
        i = index(choice)
        return [i] if 0 <= i < width else []

    step = 1 if choice.step is None else choice.step
    first = None if choice.start is None else index(choice.start)
    last = None if choice.stop is None else index(choice.stop)

    if step > 0:
        low = 0 if first is None else max(first, 0)
        high = width - 1 if last is None else min(last, width - 1)
        return list(range(low, high + 1, step))

    high = width - 1 if first is None else min(first, width - 1)
    low = 0 if last is None else max(last, 0)
    return list(range(high, low - 1, step))


def resolve_column(column: Column, header: Header | None, width: int) -> Resolved:
    '''Work out which columns one item names.
With a header, an item that exactly matches a column name refers to that column,
even when it could also be read as a position.'''

    if header is not None and not column.forced:
        matches = header.lookup(column.text)
        if len(matches) > 1:
            where = ', '.join(str(i + 1) for i in matches)
            raise DataError(f'column name {column.text!r} is ambiguous, '
                            f'since columns {where} all have it')
        if matches:
            return Resolved(column, matches, by_name=True, is_slice=False)

    try:
        choice = parse_choice(column.choice_text)
    except ValueError as e:
        raise DataError(f'{column.text!r}: {e}') from e

    if choice is None:
        raise DataError(f'no column named {column.text!r}')

    return Resolved(column, pick(choice, width), by_name=False,
                    is_slice=isinstance(choice, slice))


def resolve(columns: Iterable[Column], header: Header | None, width: int) -> list[int]:
    '''Return the 0-based positions that columns name, in order.'''
    return [i for c in columns for i in resolve_column(c, header, width).positions]


def resolve_some(column: Column, header: Header | None, width: int) -> Resolved:
    '''Work out which columns one item names, where naming none is an error.'''

    resolved = resolve_column(column, header, width)

    if not resolved.positions:
        raise out_of_range(column, width)

    return resolved


def resolve_one(column: Column, header: Header | None, width: int) -> Resolved:
    '''Work out the single column that one item names.'''

    resolved = resolve_some(column, header, width)

    if resolved.is_slice:
        raise DataError(f'{column.text!r} is a slice, where only one column is allowed')

    return resolved


def count(n: int, noun: str) -> str:
    '''Return n with noun, made plural unless n is 1.'''
    return f'{n} {noun}' if n == 1 else f'{n} {noun}s'


def out_of_range(column: Column, width: int) -> DataError:
    '''Return the error for a column that names no column of the input.'''
    return DataError(f'column {column.text!r} is out of range, '
                     f'since the input has {count(width, "column")}')


def check_forced(column: Column, single: bool = False) -> None:
    '''Check a "#" item, which needs no header to be understood.'''

    if not column.forced:
        return

    try:
        choice = parse_choice(column.choice_text)
    except ValueError as e:
        raise argparse.ArgumentTypeError(f'{column.text!r}: {e}') from e

    if choice is None:
        raise argparse.ArgumentTypeError(
                f'{column.text!r}: "#" must be followed by a position or a slice')

    if single and isinstance(choice, slice):
        raise argparse.ArgumentTypeError(
                f'{column.text!r} is a slice, where only one column is allowed')


def column_list(s: str) -> list[Column]:
    '''Split s at each comma into column items, checking what does not depend on a header.'''

    columns = [Column(item) for item in s.split(',')]

    for column in columns:
        if not column.text:
            raise argparse.ArgumentTypeError(f'{s!r} has an empty item')
        check_forced(column)

    return columns


def condition(s: str) -> Condition:
    '''Parse s as COL OP VALUE, splitting it at the first operator from the left.'''

    for i in range(len(s)):
        op = next((op for op in OPERATORS if s.startswith(op, i)), None)
        if op is not None:
            break
    else:
        raise argparse.ArgumentTypeError(
                f'{s!r} has no operator, which is one of '
                f'{", ".join((*COMPARISONS, *REGEX_OPERATORS))}')

    column = Column(s[:i].strip())
    value = s[i + len(op):].strip()

    if not column.text:
        raise argparse.ArgumentTypeError(f'{s!r} has no column before {op!r}')

    check_forced(column, single=True)

    if op in REGEX_OPERATORS:
        try:
            regex = re.compile(value)
        except re.error as e:
            raise argparse.ArgumentTypeError(f'{s!r}: invalid regex: {e}') from e
        return Condition(s, column, op, value, None, regex)

    return Condition(s, column, op, value, to_number(value), None)


def sort_key(s: str) -> SortKey:
    '''Parse s as COL[:FLAGS].
FLAGS is the text after the last ":", when that text is made only of the
letters n and r.  Otherwise the whole of s is the column, so "2:" is the slice
from column 2 onward, as in --select.  A column whose name ends in such
letters, such as "a:n", is therefore named by position.'''

    head, colon, flags = s.rpartition(':')

    if colon and flags and set(flags) <= set('nr'):
        column = Column(head)
    else:
        column, flags = Column(s), ''

    if not column.text:
        raise argparse.ArgumentTypeError(f'{s!r} has no column')

    check_forced(column)

    return SortKey(s, column, 'n' in flags, 'r' in flags)


def check_without_header(columns: Iterable[Column], single: bool = False) -> str | None:
    '''Return a problem with columns when there is no header to find names in.'''

    for column in columns:
        try:
            choice = parse_choice(column.choice_text)
        except ValueError as e:
            return f'{column.text!r}: {e}'
        if choice is None:
            return f'{column.text!r} is a column name, which needs -H'
        if single and isinstance(choice, slice):
            return f'{column.text!r} is a slice, where only one column is allowed'

    return None


def read_records(stream: TextIO, delimiter: str, source: str) -> Iterator[Record]:
    '''Yield each record of stream, numbered from 1, with the line it starts on.
Blank lines are skipped and not counted, since the csv writer never produces
one for a record that holds a value.'''

    # strict=True turns a stray quote into an error.  Without it, '"a" b' would
    # silently read as 'a b', and an unclosed quote would swallow the rest of
    # the input into one field.
    reader = csv.reader(stream, delimiter=delimiter, strict=True)
    number = 0
    start = 1

    while True:
        try:
            row = next(reader)
        except StopIteration:
            return
        except csv.Error as e:
            raise DataError(f'{source}: record {number + 1}, line {start}: {e}') from e

        if row:
            number += 1
            yield Record(number, start, row)

        # line_num counts physical lines, so a record holding a quoted line
        # break moves it on by more than one.
        start = reader.line_num + 1


def fit_rows(records: Iterable[Record], width: int, ragged: str, source: str) -> Rows:
    '''Yield each row, after making it width fields long as ragged allows.'''

    for record in records:
        row = record.row
        if len(row) == width:
            yield row
        elif len(row) < width and ragged == 'pad':
            yield row + [''] * (width - len(row))
        elif len(row) > width and ragged == 'truncate':
            yield row[:width]
        else:
            raise DataError(f'{source}: record {record.number}, line {record.line}: '
                            f'expected {count(width, "field")}, found {len(row)}')


def read(stream: TextIO, delimiter: str, has_header: bool, ragged: str,
         source: str) -> tuple[Header | None, Rows]:
    '''Read the header, if has_header, and the rows from stream.
The first record sets the width that every other row must match.'''

    records = read_records(stream, delimiter, source)
    first = next(records, None)

    if first is None:
        return None, iter(())

    width = len(first.row)

    if has_header:
        return Header(tuple(first.row)), fit_rows(records, width, ragged, source)

    return None, fit_rows(itertools.chain((first,), records), width, ragged, source)


def peek_width(header: Header | None, rows: Rows) -> tuple[int | None, Rows]:
    '''Return the width of the input, and rows with nothing consumed.
Every row already has the width of the first record, so column positions are
worked out once from it and serve every row.  The width is None when there is
neither a header nor a row.'''

    if header is not None:
        return len(header.names), rows

    first = next(rows, None)

    if first is None:
        return None, iter(())

    return len(first), itertools.chain((first,), rows)


def describe(positions: Iterable[int], header: Header | None) -> str:
    '''Describe 0-based positions as 1-based columns, with their names if known.'''

    parts = [str(i + 1) if header is None else f'{i + 1} ({header.names[i]!r})'
             for i in positions]

    if not parts:
        return 'no columns'

    return ('column ' if len(parts) == 1 else 'columns ') + ', '.join(parts)


class Debug:
    '''The diagnostics and warnings of --debug.
Everything goes to stderr, so stdout stays valid CSV.  When debugging is off,
every method returns at once, and rows pass through untouched.'''

    def __init__(self, enabled: bool, prog: str) -> None:
        self.enabled = enabled
        self.prog = prog
        self.counts: dict[str, int] = {}

    def note(self, message: str) -> None:
        '''Report what csvv made of an option.'''
        if self.enabled:
            print(f'{self.prog}: {message}', file=sys.stderr)

    def warn(self, message: str) -> None:
        '''Report questionable usage.'''
        if self.enabled:
            print(f'{self.prog}: warning: {message}', file=sys.stderr)

    def check_name(self, label: str, resolved: Resolved) -> None:
        '''Warn when a column name matched an item that could be a position.'''

        if not resolved.by_name:
            return

        try:
            choice = parse_choice(resolved.column.text)
        except ValueError:
            return

        if choice is not None:
            self.warn(f'{label} matched the column named {resolved.column.text!r}, '
                      f'so write "#{resolved.column.text}" to mean the position')

    def counting(self, rows: Rows, name: str) -> Rows:
        '''Count the rows as they pass, under name.'''

        if not self.enabled:
            return rows

        self.counts[name] = 0

        def generate() -> Rows:
            for row in rows:
                self.counts[name] += 1
                yield row

        return generate()

    def non_numbers(self, rows: Rows, checks: list[tuple[str, int]],
                    consequence: str) -> Rows:
        '''Count the cells that are not numbers, at each position that checks
names, and warn about them once every row has passed.'''

        if not self.enabled or not checks:
            return rows

        def generate() -> Rows:
            tally = [0] * len(checks)
            for row in rows:
                for k, (_, i) in enumerate(checks):
                    if to_number(row[i]) is None:
                        tally[k] += 1
                yield row
            for (label, _), n in zip(checks, tally):
                if n:
                    self.warn(f'{label} met {count(n, "cell")} that '
                              f'{"is not a number" if n == 1 else "are not numbers"}, '
                              f'which {consequence}')

        return generate()


def keep_matching(header: Header | None, rows: Rows, conditions: Iterable[Condition],
                  debug: Debug) -> tuple[Header | None, Rows]:
    '''Keep only the rows that pass every condition.'''

    width, rows = peek_width(header, rows)

    if width is None:
        return header, rows

    tests: list[tuple[Condition, int]] = []

    for c in conditions:
        label = f'-e {c.text!r}'
        resolved = resolve_one(c.column, header, width)
        debug.check_name(label, resolved)
        mode = ('a regex search' if c.regex is not None else
                'comparing numbers' if c.number is not None else 'comparing text')
        value = c.value if c.number is not None else repr(c.value)
        debug.note(f'{label}: {describe(resolved.positions, header)} {c.op} {value}, {mode}')
        tests.append((c, resolved.positions[0]))

    rows = debug.non_numbers(rows, [(f'-e {c.text!r}', i) for c, i in tests
                                    if c.number is not None], 'failed the test')

    return header, (row for row in rows if all(c.matches(row[i]) for c, i in tests))


def cell_key(cell: str, numeric: bool, reverse: bool) -> Any:
    '''Return what to sort cell by.
In a numeric key, a cell that is not a number sorts after the numbers in both
directions, and among the others in text order.  The tags 0 and 1 keep a
number from ever being compared with text.'''

    if numeric:
        n = to_number(cell)
        if n is not None:
            return (0, -n if reverse else n)
        return (1, Descending(cell) if reverse else cell)

    return Descending(cell) if reverse else cell


def sort_rows(header: Header | None, rows: Rows, keys: Iterable[SortKey],
              debug: Debug) -> tuple[Header | None, Rows]:
    '''Sort the rows by the keys, the first key taking priority.
A slice stands for one key per column, all with the same flags.  The sort is
stable, and it holds every row in memory.'''

    width, rows = peek_width(header, rows)

    if width is None:
        return header, rows

    parts: list[tuple[int, bool, bool]] = []
    numeric_checks: list[tuple[str, int]] = []

    for key in keys:
        label = f'--sort {key.text!r}'
        resolved = resolve_some(key.column, header, width)
        debug.check_name(label, resolved)
        debug.note(f'{label}: {describe(resolved.positions, header)}, '
                   f'{"as numbers" if key.numeric else "as text"}'
                   f'{", reversed" if key.reverse else ""}')
        parts.extend((i, key.numeric, key.reverse) for i in resolved.positions)
        if key.numeric:
            numeric_checks.extend((label, i) for i in resolved.positions)

    debug.note('sorting holds every row in memory')

    rows = debug.non_numbers(rows, numeric_checks, 'sorted after the numbers')

    def row_key(row: Row) -> tuple[Any, ...]:
        return tuple(cell_key(row[i], numeric, reverse) for i, numeric, reverse in parts)

    return header, iter(sorted(rows, key=row_key))


def select(header: Header | None, rows: Rows, columns: Iterable[Column],
           debug: Debug) -> tuple[Header | None, Rows]:
    '''Keep only the named columns, in the order named.'''

    width, rows = peek_width(header, rows)

    if width is None:
        return header, rows

    positions: list[int] = []

    for column in columns:
        label = f'--select {column.text!r}'
        resolved = resolve_column(column, header, width)
        debug.check_name(label, resolved)
        if resolved.positions:
            debug.note(f'{label}: {describe(resolved.positions, header)}')
        else:
            debug.warn(f'{label} was ignored, since the input has '
                       f'{count(width, "column")}')
        positions.extend(resolved.positions)

    if header is not None:
        header = Header(tuple(header.names[i] for i in positions))

    return header, ([row[i] for i in positions] for row in rows)


def write(stream: TextIO, delimiter: str, header: Header | None, rows: Rows) -> None:
    '''Write the header, if any, and the rows to stream as CSV.'''

    # The default line terminator is '\r\n', which upsets diff and wc -l.
    writer = csv.writer(stream, delimiter=delimiter, lineterminator='\n')

    if header is not None:
        writer.writerow(header.names)

    writer.writerows(rows)


def configure_stdio() -> None:
    '''Set up stdin and stdout the way the csv module needs them.'''

    # newline='' keeps a quoted line break intact and stops '\r\n' from
    # doubling on Windows.  utf-8-sig drops a byte-order mark, which would
    # otherwise join the first column name.  surrogateescape passes invalid
    # UTF-8 through unchanged.
    if isinstance(sys.stdin, io.TextIOWrapper):
        sys.stdin.reconfigure(encoding='utf-8-sig', errors='surrogateescape', newline='')
    if isinstance(sys.stdout, io.TextIOWrapper):
        sys.stdout.reconfigure(encoding='utf-8', errors='surrogateescape', newline='')


def make_parser() -> argparse.ArgumentParser:
    '''Build the command-line parser.'''

    description_lines = (
            'Filter, sort, and select the columns of a CSV file.',
            'Read FILE, or stdin when FILE is absent or "-", and write CSV to stdout.',
            )

    epilog_lines = (
            r'CHAR is one character, or \t for a tab.',
            'A tab separator still honors CSV quoting.',
            '',
            'With -H, the header is written first.',
            'Pipe the output to "tail -n +2" to drop it,',
            'unless a quoted header field spans lines.',
            '',
            'Every record must have as many fields as the first, unless --ragged says otherwise.',
            '',
            'LIST is a comma-separated list of columns.',
            'Each column is a position, a slice, or a name from the header.',
            'Positions start at 1, and negative ones count from the end.',
            'A slice is START:STOP:STEP, as in Python, except that STOP is included.',
            'With -H, an exact column name wins, and a "#" prefix forces a position, as in #3.',
            'A position out of range is ignored.',
            '',
            'EXPR is COL OP VALUE, where COL is one column, and OP is one of',
            '==, !=, <, <=, >, >=, ~, or !~.',
            '~ and !~ test whether the regex VALUE is found in the cell.',
            'The other operators compare numbers when VALUE is a number, and text otherwise.',
            'In a numeric test, a cell that is not a number fails every operator but !=.',
            'A row must match every -e.',
            '',
            'KEY is COL[:FLAGS], where COL is a column or a slice of columns.',
            'FLAGS holds n to compare numbers, r to reverse, or both, as in median:nr.',
            'A slice stands for one key per column, all with the same FLAGS.',
            'Text after the last ":" is FLAGS only if it holds nothing but n and r.',
            'In a numeric key, cells that are not numbers sort after the numbers.',
            'Text compares by code point, like LC_ALL=C sort.',
            'The sort is stable, and the first --sort takes priority.',
            '',
            'csvv filters first, then sorts, then selects, whatever order the options are in.',
            'Use -e=EXPR, --sort=KEY, or --select=LIST if the value starts with "-".',
            '',
            'Examples:',
            "  %(prog)s -F ';' in.csv                convert semicolon-separated input to CSV",
            r"  %(prog)s -o '\t' in.csv | column -t -s $'\t'",
            '                                    show the input as an aligned table',
            '  %(prog)s --select 2:4 in.csv          columns 2 through 4',
            '  %(prog)s --select=-1 in.csv           the last column',
            '  %(prog)s --select ::-1 in.csv         every column, in reverse order',
            '  %(prog)s -H --select name,1 in.csv    the column named "name", then the first',
            "  %(prog)s -H -e 'median<0.03' in.csv   rows whose median is below 0.03",
            "  %(prog)s -H -e 'name~^B' in.csv       rows whose name starts with B",
            '  %(prog)s -H --sort median:n in.csv    rows by increasing median',
            '  %(prog)s --sort 2:3:nr in.csv         rows by columns 2 and 3, largest first',
            )

    version_lines = (f'%(prog)s {__version__}',
                    f'License: {__license__}',
                    f'Written by {__author__}')

    parser = argparse.ArgumentParser(
            usage='%(prog)s [OPTION]... [FILE]',
            description='\n'.join(description_lines),
            epilog='\n'.join(epilog_lines),
            formatter_class=argparse.RawTextHelpFormatter)

    parser.add_argument('-V', '--version', action='version', version='\n'.join(version_lines))

    parser.add_argument('--debug', action='store_true',
            help='print diagnostics and warnings to stderr')

    parser.add_argument('-H', '--header', action='store_true',
            help='the first record holds column names')

    parser.add_argument('-F', '--delimiter', metavar='CHAR', type=separator, default=',',
            help='the input field separator (default ",")')

    parser.add_argument('-o', '--output-delimiter', metavar='CHAR', type=separator,
            help='the output field separator (default: the input separator)')

    parser.add_argument('--ragged', metavar='MODE', choices=RAGGED_MODES, default='error',
            help='handle a record whose length differs from the first record:\n'
                 'error (the default), pad with empty fields, or truncate')

    parser.add_argument('-e', '--filter', metavar='EXPR', type=condition, action='append',
            default=[], help='keep only rows matching EXPR (repeatable)')

    parser.add_argument('--sort', metavar='KEY', type=sort_key, action='append',
            default=[], help='sort rows by KEY (repeatable)')

    parser.add_argument('--select', metavar='LIST', type=column_list, action='append',
            default=[], help='output only the columns in LIST, in that order (repeatable)')

    parser.add_argument('FILE', nargs='?', default='-',
            help='the CSV file to read')

    return parser


def process(args: argparse.Namespace, selected: list[Column], stream: TextIO, source: str,
            debug: Debug) -> None:
    '''Filter, sort, and select the rows of stream, and write them to stdout.'''

    header, rows = read(stream, args.delimiter, args.header, args.ragged, source)
    rows = debug.counting(rows, 'read')

    if args.filter:
        header, rows = keep_matching(header, rows, args.filter, debug)
        rows = debug.counting(rows, 'kept by the filter')

    if args.sort:
        header, rows = sort_rows(header, rows, args.sort, debug)

    if selected:
        header, rows = select(header, rows, selected, debug)

    rows = debug.counting(rows, 'written')

    out_delimiter = args.delimiter if args.output_delimiter is None else args.output_delimiter
    write(sys.stdout, out_delimiter, header, rows)

    if debug.counts:
        summary = ', '.join(f'{name}: {n}' for name, n in debug.counts.items())
        debug.note(f'rows {summary}{" (not counting the header)" if header else ""}')


# pylint: disable=missing-function-docstring
def main(argv: list[str] | None = None) -> int | None:

    parser = make_parser()
    args = parser.parse_args(argv)

    selected = [column for columns in args.select for column in columns]

    if not args.header:
        if problem := check_without_header((c.column for c in args.filter), single=True):
            parser.error(f'argument -e/--filter: {problem}')
        if problem := check_without_header(k.column for k in args.sort):
            parser.error(f'argument --sort: {problem}')
        if problem := check_without_header(selected):
            parser.error(f'argument --select: {problem}')

    csv.field_size_limit(FIELD_SIZE_LIMIT)
    configure_stdio()

    try:
        with contextlib.ExitStack() as stack:
            if args.FILE == '-':
                stream: TextIO = sys.stdin
                source = 'stdin'
            else:
                stream = stack.enter_context(open(args.FILE, encoding='utf-8-sig',
                        errors='surrogateescape', newline=''))
                source = args.FILE

            process(args, selected, stream, source, Debug(args.debug, parser.prog))

    except OSError as e:
        # A failed write to stdout has no file name.
        where = '' if e.filename is None else f'{e.filename}: '
        print(f'{parser.prog}: {where}{e.strerror}', file=sys.stderr)
        return 1

    except DataError as e:
        sys.stdout.flush()
        print(f'{parser.prog}: {e}', file=sys.stderr)
        return 1

    return 0


if __name__ == '__main__':
    sys.exit(main())
